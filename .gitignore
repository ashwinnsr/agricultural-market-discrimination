# .gitignore for R project

# Data files (usually too large for GitHub)
*.sav
*.rds
*.csv
*.xlsx
*.dta

# R Environment
.Rhistory
.RData
.Rproj.user

# Output files
*.pdf
*.png
*.jpg
*.jpeg

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp

# IDE files
.vscode/
.idea/
*.Rproj